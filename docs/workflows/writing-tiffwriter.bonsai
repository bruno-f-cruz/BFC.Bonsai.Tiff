<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:tiff="clr-namespace:BFC.Bonsai.Tiff;assembly=BFC.Bonsai.Tiff"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="tiff:TiffReader">
          <tiff:FileName>stack.tif</tiff:FileName>
          <tiff:PageIndex>0</tiff:PageIndex>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="tiff:TiffWriter">
          <tiff:FileName>stack-out.tif</tiff:FileName>
          <tiff:UseBigTiff>true</tiff:UseBigTiff>
          <tiff:Compression>LZW</tiff:Compression>
          <tiff:WriteMode>CreateNew</tiff:WriteMode>
          <tiff:Predictor>Horizontal</tiff:Predictor>
        </Combinator>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
